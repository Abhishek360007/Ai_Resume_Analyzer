# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=postgres

# LLM Studio Configuration (Local AI)
LLM_STUDIO_BASE_URL=http://localhost:1234
LLM_STUDIO_MODEL=mistralai/ministral-3-14b-reasoning
LLM_STUDIO_EMBEDDING_MODEL=nomic-embed-text
LLM_STUDIO_API_KEY=not-needed
LLM_STUDIO_TIMEOUT=120000

# Application Configuration
UPLOAD_DIR=./uploads

# Server Configuration
SERVER_PORT=8080

# ---------------------------------------------------------------
# Alternative LLM providers
# LM Studio is the default. To switch, activate a Spring profile:
# ---------------------------------------------------------------

# Ollama (local) - run: ollama pull llama3.1:8b && ollama pull nomic-embed-text
# SPRING_PROFILES_ACTIVE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Google Gemini (free tier) - key from https://aistudio.google.com/apikey
# SPRING_PROFILES_ACTIVE=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (cloud)
# SPRING_PROFILES_ACTIVE=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
